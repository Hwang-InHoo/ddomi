# 또미 — 비밀값 보관용 견본. 실제 값은 절대 이 파일에 넣지 않는다.
# .env 를 따로 만들어 거기에만 값을 넣는다 (.env 는 .gitignore 에 등록돼 있다).

# Supabase service_role (secret) 키. tools/upload_places.py 가 전국 검색 색인을
# 올릴 때만 쓴다. 브라우저로 나가는 코드에는 절대 넣지 않는다 —
# 사이트에서 쓰는 공개 키는 config.js 의 SUPABASE_KEY 쪽이다.
SUPABASE_SERVICE_KEY=

# 기본값은 또미 프로젝트라 비워 둬도 된다.
SUPABASE_URL=
